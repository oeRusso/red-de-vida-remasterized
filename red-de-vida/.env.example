# Mismas variables que el backend Express. `next dev` usa MONGO_URI_DEV; `next start`, MONGO_URI_PROD.
MONGO_URI_DEV=mongodb://127.0.0.1:27017/reddevida
MONGO_URI_PROD=
# Generar con: openssl rand -base64 32
JWT_SECRET=
# _id de los usuarios administradores, separados por comas (el seed imprime el de la cuenta demo).
ADMIN_USER_IDS=
