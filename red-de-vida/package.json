{
  "name": "red-de-vida",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-api.mjs",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.mts",
    "db:indexes": "tsx --env-file-if-exists=.env.local scripts/sync-indexes.mts",
    "db:memory": "tsx --env-file-if-exists=.env.local scripts/memory-db.mts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.14",
    "lucide-react": "^1.66.0",
    "mongoose": "^9.11.4",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
