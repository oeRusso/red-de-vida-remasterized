# Plantilla del .env de producción (en el VPS, ~/reddevida/.env, chmod 600). Sin secretos.
# Las contraseñas se generan en el VPS con: openssl rand -hex 32

# Contraseña del usuario root de MongoDB (solo alcanzable dentro de la red del compose).
MONGO_PASSWORD=
# Firma de las cookies de sesión.
JWT_SECRET=
# Contraseña de admin@reddevida.test que crea el seed de demostración en producción.
SEED_ADMIN_PASSWORD=
# _id de los administradores, separados por comas. Lo imprime el seed.
ADMIN_USER_IDS=
# Token del Cloudflare Tunnel "reddevida" (lo carga Esteban).
TUNNEL_TOKEN=
